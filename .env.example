# DB 접속 정보
# 주의: 이 값들의 실제 소스는 ../places-api-project/docker-compose.yml 이다.
# 그 파일의 postgres 서비스 environment 값이 바뀌면 여기도 반드시 같이 바꿔야 한다.
# (이 서브프로젝트는 자체 docker-compose.yml을 만들지 않고 그 컨테이너를 그대로 재사용한다)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contest_db
DB_USER=postgres
DB_PASSWORD=postgres

# 이번 파일럿 범위를 고정하는 값들.
# TARGET_LINE=A: data/03_지역특성_규모_업종_분석보고서.md 근거로 "동네 골목상권형" 성격이 확인된 유일한 선로.
# TARGET_DONG=화곡동: 소상공인 상가정보 CSV의 법정동명 기준(행정동명은 화곡1~8동으로 쪼개져 있어 단일값이 아님).
#   화곡동을 고른 이유는 places-api-project의 검증 예제 상호("화곡영양족발")와 일관성을 유지하기 위함 -
#   AMI 데이터 자체에는 위치 정보가 전혀 없으므로 이 선택은 데모 일관성을 위한 임의 지정일 뿐, 실제 계기 위치가 아니다.
TARGET_LINE=A
TARGET_DONG=화곡동

# 화곡동 재매칭 시 02_match_store.py와 동일한 무작위 비복원추출 로직을 재현하기 위한 시드.
# 다른 값으로 바꾸면 어떤 계기가 어떤 상가에 매칭되는지 달라진다(재현성을 위해 고정값 유지 권장).
RNG_SEED=42

# Google Places API 키
GOOGLE_PLACES_API_KEY= # .env 넣어놓았음.